# Токен существующего Telegram-бота от @BotFather. Не публикуйте .env.
BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN

# Только разрешённые числовые Telegram user ID, через запятую.
# 1 — временная заглушка для первого запуска и команды /whoami.
# Замените на свой ID после /whoami и перезапустите бота.
ALLOWED_USER_IDS=1

# Для ИИ нужен свой API-ключ. Можно оставить пустым: локальные функции работают.
# Подписка ChatGPT сама по себе не предоставляет оплату API.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Пустое значение: SQLite в data/accountant.db рядом с bot.py.
DATABASE_URL=
# Для PostgreSQL (отдельная БД для этого приложения):
# DATABASE_URL=postgresql+psycopg://bot_user:PASSWORD@localhost:5432/accountant
# Пароли со специальными символами должны быть URL-encoded.

TIMEZONE=Europe/Moscow
